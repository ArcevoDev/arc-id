{
  "name": "arc-id",
  "version": "0.1.0",
  "description": "Sovereign Decentralized Identity (DID) & Access Management Engine powering the ArcevoCirqle ecosystem. Built on Fastify, Prisma, and WebAuthn/Passkeys with native support for OIDC, SD-JWT Verifiable Credentials, and multi-tenant policy structures.",
  "private": true,
  "type": "module",
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev:web": "cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack",
    "build:web": "cross-env NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start:web": "next start",
    "dev:api": "tsx watch --tsconfig tsconfig.api.json src/api/server/start-server.ts",
    "dev:workers": "tsx watch --tsconfig tsconfig.api.json src/api/server/start-workers.ts",
    "build:api": "tsup",
    "build:api:output": "pnpm build:api > .agent/api-build-output.txt 2>&1",
    "start:api": "node dist/start-server.js",
    "start:workers": "node dist/start-workers.js",
    "dev": "pnpm run dev:all",
    "dev:all": "concurrently \"pnpm run dev:web\" \"pnpm run dev:api\" \"pnpm run dev:workers\"",
    "mail:preview": "tsx src/api/server/start-server.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:run": "npx prisma validate && pnpm prisma:format && pnpm prisma:migrate && pnpm prisma:generate",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "typecheck:output": "pnpm typecheck > .agent/typecheck-output.txt 2>&1",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:output": "pnpm test > .agent/test-output.txt 2>&1",
    "test:coverage": "vitest run --coverage",
    "test:rollback": "vitest run prisma/migrations/rollback.test.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts"
  },
  "dependencies": {
    "@arcevo/facet-auth": "1.2.3",
    "@arcevo/facet-cli": "^2.0.0",
    "@arcevo/facet-components": "1.11.0",
    "@arcevo/facet-docs": "1.4.7",
    "@arcevo/facet-emails": "^1.1.1",
    "@arcevo/facet-layout": "1.4.2",
    "@arcevo/facet-sdk": "1.2.0",
    "@arcevo/facet-store": "^2.0.0",
    "@arcevo/facet-tokens": "1.1.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/under-pressure": "^9.1.0",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sd-jwt/core": "^0.20.0",
    "@sd-jwt/sd-jwt-vc": "^0.20.0",
    "@simplewebauthn/server": "^13.3.2",
    "@upstash/redis": "^1.38.2",
    "arctic": "^3.7.0",
    "argon2": "^0.44.0",
    "date-fns": "^4.4.0",
    "fastify": "^5.11.3",
    "fastify-metrics": "^13.2.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "jose": "^6.2.8",
    "next": "16.3.2",
    "otplib": "^13.4.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.19.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.24.0"
}
