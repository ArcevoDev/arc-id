# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# lock-file — committed: deploy workflows run pnpm install --frozen-lockfile
# pnpm-lock.yaml

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
certs/*
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/prisma/generated/
.zhanlu/
.husky\_/

# design standards
ArcevoCirqle_Design_Standards_Manual_v1.0..txt

# agent state
.agent/logs.txt
.agent/*.txt.tmp
